// Prisma schema for Tripbook

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TravelMode {
  WALK
  CAR
  TRAIN
  BUS
  BIKE
  BOAT
  PLANE
}

enum ActivityType {
  HOTEL
  SHOPPING
  FREE_TIME
  PARK
  MUSEUM
  FOOD
  SIGHTSEEING
  NIGHTLIFE
  BEACH
  NATURE
  EVENT
  OTHER
}

model Trip {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flights    Flight[]
  activities Activity[]

  @@index([slug])
}

model Flight {
  id       String @id @default(uuid())
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId   String

  airline       String?
  flightNumber  String?
  fromAirport   String
  toAirport     String
  departureAt   DateTime
  arrivalAt     DateTime
  overnight     Boolean  @default(false)
  confirmation  String?
  notes         String?
  sortOrder     Int      @default(0)

  @@index([tripId])
}

// Activities can nest one level: a top-level activity (e.g. a park, a street)
// can contain child activities (e.g. things to do inside the park, stores on the street).
model Activity {
  id       String @id @default(uuid())
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId   String

  parent   Activity?  @relation("ActivityChildren", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  children Activity[] @relation("ActivityChildren")

  title       String
  type        ActivityType?
  /** Marked "if possible" — may or may not fit into the day. Rendered with
   * a dashed border to signal it's not committed. */
  tentative   Boolean       @default(false)
  description String?
  location    String?

  date              DateTime?  @db.Date
  startTime         DateTime?
  endTime           DateTime?
  overnight         Boolean    @default(false)
  recommendedMins   Int?

  travelMode        TravelMode?
  travelMinsFromPrev Int?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([parentId])
}
